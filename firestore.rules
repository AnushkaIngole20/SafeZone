rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny access by default to prevent accidental data leaks
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated User-Scoped Root: users/{userId}
    match /users/{userId} {
      // User can only read and write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Profile Subcollection: users/{userId}/profile/{docId}
      match /profile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Emergency Contacts Subcollection: users/{userId}/emergencyContacts/{docId}
      match /emergencyContacts/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Incident Reports Subcollection: users/{userId}/incidents/{incidentId}
      match /incidents/{incidentId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Settings Subcollection: users/{userId}/settings/{settingId}
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
