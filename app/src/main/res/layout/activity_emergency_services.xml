<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBgColor"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Services"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Immediate one-tap dial access to verified emergency helplines"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="14sp" />

        <!-- Ambulance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚑   Ambulance &amp; Medical"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Emergency medical dispatch &amp; paramedics (Helpline: 108)"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnAmbulance"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sos_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📞   CALL 108 NOW"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Police Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚓   Police &amp; National Emergency"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Police control room &amp; national emergency response (Helpline: 112)"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnPolice"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📞   CALL 112 NOW"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Fire Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚒   Fire &amp; Rescue Services"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fire brigade &amp; disaster search-and-rescue (Helpline: 101)"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnFire"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sos_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📞   CALL 101 NOW"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Nearby Hospitals -->
        <TextView
            android:id="@+id/btnHospitals"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_action_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🏥   Find Nearby Hospitals"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Emergency Map -->
        <TextView
            android:id="@+id/btnEmergencyMap"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🗺️   Find All Emergency Services on Maps"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>