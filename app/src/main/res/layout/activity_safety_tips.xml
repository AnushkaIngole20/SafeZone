<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBgColor"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Tips &amp; Guides"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Actionable protocols to keep you and your loved ones secure"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSafetyNotification"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔔   SEND TEST SAFETY ALERT"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tipTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Essential Safety Modules"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Personal Safety Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️   Personal &amp; Transit Safety"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Stay aware of your surroundings, avoid secluded areas at night, and keep your live location shared with emergency contacts."
                android:textColor="?attr/textSecondaryColor"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Digital Safety Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱   Digital Security &amp; Anti-Scam"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Never share OTPs, bank details, or live tracking links with strangers. Beware of urgent impersonation calls claiming family emergencies."
                android:textColor="?attr/textSecondaryColor"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Travel Safety Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗   Travel &amp; Commuter Safety"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Always verify license plate details and driver identity before entering rideshares. Keep power banks charged."
                android:textColor="?attr/textSecondaryColor"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Fire Safety Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥   Fire Evacuation &amp; Hazards"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Locate fire exits immediately upon entering buildings. In heavy smoke, stay close to the floor and never use elevators."
                android:textColor="?attr/textSecondaryColor"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Health Safety Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥   Medical &amp; First Aid Basics"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Keep essential medical info and blood type in your SAFEZONE profile. Learn basic CPR chest compression techniques."
                android:textColor="?attr/textSecondaryColor"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>